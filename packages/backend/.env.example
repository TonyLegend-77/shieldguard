PORT=4000

# BOT Chain RPC + chain id
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968

# Key used ONLY for anchoring receipts on-chain / contract deployment.
SIGNER_PRIVATE_KEY=0x...
SIGNER_ADDRESS=0x...

# Separate key that co-signs every allowed transaction in /api/oracle/evaluate.
# This is the one your live deploy is missing — without it, the dashboard's
# "Generate co-signature" button will always return
# "Oracle not configured on this server — set ORACLE_PRIVATE_KEY and RPC_URL."
# Do NOT reuse SIGNER_PRIVATE_KEY here (see validationOracle.js comments).
ORACLE_PRIVATE_KEY=0x...

# Contracts
RECEIPT_REGISTRY_ADDRESS=0x...
BOT_TOKEN_ADDRESS=0x...
TREASURY_ADDRESS=0x...
USDT_ADDRESS=0x...
WBOT_ADDRESS=0x...
KNOWN_NFT_OPERATORS=

# Storage
USE_SQLITE=true
SQLITE_PATH=./data.sqlite

# Tiering
FREE_TIER_MAX_CONTRACTS=3
PUBLIC_TX_LIMIT=100
PRIVATE_TX_LIMIT=1000
PRIVATE_TIER_PRICE_BOT=5

# Alerts
TELEGRAM_BOT_TOKEN=
ALERT_WEBHOOK_URLS=
ALERT_WEBHOOK_SECRET=

# AI advisory stage (pick whichever provider validationOracle.js is wired to use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Admin
ADMIN_API_KEY=
