PORT=4000

# BOT Chain RPC + chain id
RPC_URL=https://rpc.botchain.ai
CHAIN_ID=677
EXPLORER_URL=https://scan.botchain.ai

# Key used ONLY for anchoring receipts on-chain / contract deployment.
SIGNER_PRIVATE_KEY=0x...
SIGNER_ADDRESS=0x...

# Separate key that co-signs every allowed transaction in /api/oracle/evaluate.
# This is the one your live deploy is missing — without it, the dashboard's
# "Generate co-signature" button will always return
# "Oracle not configured on this server — set ORACLE_PRIVATE_KEY and RPC_URL."
# Do NOT reuse SIGNER_PRIVATE_KEY here (see validationOracle.js comments).
ORACLE_PRIVATE_KEY=0x...

# Contracts
RECEIPT_REGISTRY_ADDRESS=0x...
# WBOT doubles as both the payment token (BOT_TOKEN_ADDRESS, verified in
# connections.js for Private/Premium/Ultra upgrades) and one of the two
# statically-monitored contracts on the live feed (WBOT_ADDRESS, used by
# listener.js) — same contract, two roles, hence the same address twice.
BOT_TOKEN_ADDRESS=0xd5452816194a3784dBa983426cCe7c122F4abd30
WBOT_ADDRESS=0xd5452816194a3784dBa983426cCe7c122F4abd30
TREASURY_ADDRESS=0x4ef8a7cd822a1b4eb13c5ca565bf21491a08fc37
USDT_ADDRESS=0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C
KNOWN_NFT_OPERATORS=

# Storage
USE_SQLITE=true
SQLITE_PATH=./data.sqlite
# How many alerts to retain for the live feed / search. SQLite handles this
# easily; only lower it if running the in-memory store.js fallback on a
# memory-constrained instance.
MAX_ALERTS=5000

# Tiering
FREE_TIER_MAX_CONTRACTS=3
PUBLIC_TX_LIMIT=100
PRIVATE_TX_LIMIT=1000
PRIVATE_TIER_PRICE_BOT=5

# Alerts
TELEGRAM_BOT_TOKEN=
ALERT_WEBHOOK_URLS=
ALERT_WEBHOOK_SECRET=

# AI advisory stage (pick whichever provider validationOracle.js is wired to use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Admin
ADMIN_API_KEY=
