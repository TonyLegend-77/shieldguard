# Backend API this frontend calls (server.js / webhook.js)
NEXT_PUBLIC_API_URL=https://your-backend.example.com

# BOT Chain network, used by useWallet() to prompt MetaMask to switch/add
# the chain when the connected wallet is on the wrong network.
NEXT_PUBLIC_CHAIN_ID=968
NEXT_PUBLIC_CHAIN_NAME=BOT Chain Testnet
NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_EXPLORER_URL=https://scan.bohr.life

# Required for the "upgrade to premium" flows in ConnectionsPanel and the
# private-tier flow in MyContracts. Without these two, the free-tier paths
# still work but paid upgrades are hidden (canUpgrade / canUsePrivate is false).
NEXT_PUBLIC_TREASURY_ADDRESS=0x...
NEXT_PUBLIC_BOT_TOKEN_ADDRESS=0x...
NEXT_PUBLIC_CONNECTIONS_PREMIUM_PRICE_BOT=1
NEXT_PUBLIC_PRIVATE_TIER_PRICE_BOT=5

# Optional — shown in ConnectionsPanel's "link Telegram for alerts" step.
# Omit and it just says "message the ShieldGuard bot" instead of @handle.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourAlertsBot
