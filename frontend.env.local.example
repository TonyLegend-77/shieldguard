# Backend API this frontend calls (server.js / webhook.js)
NEXT_PUBLIC_API_URL=https://your-backend.example.com

# BOT Chain network, used by useWallet() to prompt MetaMask to switch/add
# the chain when the connected wallet is on the wrong network.
NEXT_PUBLIC_CHAIN_ID=677
NEXT_PUBLIC_CHAIN_NAME=BOT Chain
NEXT_PUBLIC_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_EXPLORER_URL=https://scan.botchain.ai

# Required for the "upgrade to premium" flows in ConnectionsPanel and the
# private-tier flow in MyContracts. Without these two, the free-tier paths
# still work but paid upgrades are hidden (canUpgrade / canUsePrivate is false).
# NOTE: this is WBOT (wrapped BOT, an ERC-20), not native BOT — native BOT
# is the chain's gas token and can't be verified via Transfer events, which
# is what connections.js checks for. Users pay in WBOT; MyContracts.jsx and
# ConnectionsPanel.jsx both show a "wrap BOT first" note pointing at BDEX.
NEXT_PUBLIC_TREASURY_ADDRESS=0x4ef8a7cd822a1b4eb13c5ca565bf21491a08fc37
NEXT_PUBLIC_BOT_TOKEN_ADDRESS=0xd5452816194a3784dBa983426cCe7c122F4abd30
NEXT_PUBLIC_CONNECTIONS_PREMIUM_PRICE_BOT=1
NEXT_PUBLIC_PRIVATE_TIER_PRICE_BOT=5

# Ultra Private: wallet-wide yearly subscription, unlimited contracts + tx.
NEXT_PUBLIC_ULTRA_TIER_PRICE_BOT=10

# Optional — shown in ConnectionsPanel's "link Telegram for alerts" step.
# Omit and it just says "message the ShieldGuard bot" instead of @handle.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourAlertsBot

# Required for wallet connect to work on mobile browsers without an
# injected provider (Safari, Chrome mobile, etc). Free — create a project
# at https://cloud.reown.com and paste the Project ID here. Without this,
# useWallet() falls back to the injected-provider-only path, which only
# works on desktop with an extension or inside a wallet app's own browser.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
